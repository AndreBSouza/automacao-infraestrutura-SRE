# SAI — environment configuration template.
#
# Copy to `.env` for LOCAL DEVELOPMENT ONLY and fill in real values.
# NEVER commit `.env`. In staging/prod, these are injected at runtime from
# Azure Key Vault via Managed Identity — not from a plaintext file or
# process env set by hand. See README.md "SECURITY" section.

# ---------------------------------------------------------------------------
# App / general
# ---------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# Strong random secret used to sign app session JWTs. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Postgres (with pgvector extension)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sai:sai@localhost:5432/sai

# ---------------------------------------------------------------------------
# Anthropic (Claude) — https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo padrão do CHAT.
ANTHROPIC_MODEL=claude-sonnet-5
# Modelo do VIGIA (triagem automática de alertas).
#
# Iguais de propósito: caches de prompt são POR MODELO. Mantendo as duas rotas
# no mesmo modelo, elas compartilham um único cache — cada requisição de uma
# mantém o cache quente para a outra. Modelos diferentes criariam dois caches
# independentes, cada um pagando a própria escrita com metade das leituras, o
# que em volume baixo custa mais do que economiza.
ANTHROPIC_VIGIA_MODEL=claude-sonnet-5
# Modelo de ESCALONAMENTO — acionado pontualmente pelo operador, marcando
# "Análise aprofundada" no chat, quando a resposta padrão não convence.
#
# Nunca é automático: a decisão é sempre humana, e vale só para aquela
# mensagem (desarma sozinho depois). Escalar troca de modelo e portanto de
# cache, então aquele turno paga o prompt cheio — é o custo consciente de
# pedir mais profundidade.
ANTHROPIC_ESCALATION_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
# TTL do cache do prompt: "5m" ou "1h".
#
# O cache guarda a parte fixa e cara de toda requisição (system prompt +
# definições de tools). Escolha pelo intervalo entre requisições:
#   < 5 min  -> "5m"  (cada requisição renova o cache; mais barato)
#   5-60 min -> "1h"  (única faixa em que a escrita 2x se paga)
#
# Padrão "1h": com poucos incidentes por dia e perguntas esparsas no chat, as
# requisições ficam tipicamente a 15-30 min umas das outras. Se o uso crescer
# e elas passarem a chegar a cada poucos minutos, troque para "5m" — aí o TTL
# longo só custa a escrita dobrada, sem benefício.
#
# Como saber qual está valendo: acompanhe `cache_read_input_tokens` (leituras
# baratas) contra `cache_creation_input_tokens` (escritas caras) no Console.
# Muitas escritas e poucas leituras = o cache está expirando antes do próximo
# uso.
ANTHROPIC_CACHE_TTL=1h

# ---------------------------------------------------------------------------
# Embeddings — Voyage AI (Anthropic's recommended embeddings partner;
# Anthropic itself does not offer a first-party embeddings endpoint).
# Get a key at https://dash.voyageai.com/
# ---------------------------------------------------------------------------
EMBEDDINGS_API_BASE=https://api.voyageai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3-large
EMBEDDINGS_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Azure — Service Principal with Reader role at subscription scope for
# reads. See README.md for exact steps (`az ad sp create-for-rbac`).
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Separate, more privileged Service Principal used ONLY for approved write
# actions (Virtual Machine Contributor etc. on specific resources — never
# Owner/Contributor at subscription scope). Leave blank to reuse the read
# credential in dev, but ALWAYS separate them in staging/prod.
AZURE_WRITE_CLIENT_ID=
AZURE_WRITE_CLIENT_SECRET=
# Log Analytics workspace GUID used by `azure_get_activity_log`. NOT the same
# value as AZURE_SUBSCRIPTION_ID. Get it with:
#   az monitor log-analytics workspace show -g <rg> -n <name> --query customerId -o tsv
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Entra ID (Azure AD) — app registration for user login (OIDC)
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# Bootstrap do primeiro admin.
#
# Todo usuário novo entra como 'viewer', e promover exige um admin — o que no
# banco vazio ninguém é. Com isto em `true`, o PRIMEIRO login vira admin.
#
# Só funciona com a tabela `users` vazia: o segundo login é 'viewer' normal,
# mesmo que você esqueça isto ligado. Ainda assim, DESLIGUE depois de criar o
# seu usuário — é a diferença entre uma porta que abriu uma vez e uma porta
# destrancada. A promoção fica registrada na auditoria como system:bootstrap.
#
# Alternativa sem esta flag: rode scripts/seed_admin.py com o seu Object ID
# do Entra (az ad user show --id voce@empresa.com --query id -o tsv).
BOOTSTRAP_FIRST_ADMIN=false

# ---------------------------------------------------------------------------
# Azure DevOps — PAT scoped to Code:Read, Build:Read&Execute,
# Release:Read&Execute, Work Items:Read
# ---------------------------------------------------------------------------
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# ---------------------------------------------------------------------------
# SQL Server — separate read/write connection strings (SPEC 10.2)
# ---------------------------------------------------------------------------
SQL_READ_CONN_STRING=
SQL_WRITE_CONN_STRING=

# ---------------------------------------------------------------------------
# Grafana — Service Account token
# ---------------------------------------------------------------------------
GRAFANA_BASE_URL=https://grafana.internal.example.com
GRAFANA_API_TOKEN=

# ---------------------------------------------------------------------------
# Zabbix — API token (user with read permission on relevant host groups)
# ---------------------------------------------------------------------------
ZABBIX_BASE_URL=https://zabbix.internal.example.com
ZABBIX_API_TOKEN=

# ---------------------------------------------------------------------------
# Linux / Nginx — SSH with a DEDICATED key (never password), sudoers
# restricted to an explicit allowlisted command set on each managed host.
# ---------------------------------------------------------------------------
LINUX_SSH_USER=sai-automation
LINUX_SSH_PRIVATE_KEY_PATH=/run/secrets/sai_ssh_key
KNOWN_LINUX_HOSTS=
KNOWN_SQL_DATABASES=

# ---------------------------------------------------------------------------
# F5 BIG-IP — dedicated non-admin API user via iControl REST
# ---------------------------------------------------------------------------
F5_BASE_URL=f5.internal.example.com
F5_API_USER=
F5_API_PASSWORD=

# ---------------------------------------------------------------------------
# Teams / Slack notifications for the Approval Engine
# ---------------------------------------------------------------------------
# TEAMS_WEBHOOK_URL only SENDS the approval card. Receiving a click requires
# the bot registration below: TEAMS_BOT_APP_ID is used to validate the Bot
# Framework JWT on every callback. If it is blank, approvals via Teams are
# REFUSED (fail-closed) — there is no "skip verification" mode.
TEAMS_WEBHOOK_URL=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
SLACK_BOT_TOKEN=
# Likewise: blank SLACK_SIGNING_SECRET disables Slack approvals entirely
# rather than accepting unsigned requests.
SLACK_SIGNING_SECRET=

# IMPORTANT — approvals are attributed to a real person, never to a generic
# service account. Each user who should be able to approve from chat needs
# their platform identity mapped in the `users` table:
#   Teams -> users.entra_object_id must equal the Entra object id (the value
#            Teams sends as `from.aadObjectId`)
#   Slack -> users.slack_user_id must equal their Slack member id (e.g. U012ABC)
# An unmapped identity is refused with 403, never approved anonymously.

# ---------------------------------------------------------------------------
# Approval engine timeouts (minutes) — SPEC 7.2
# ---------------------------------------------------------------------------
APPROVAL_TIMEOUT_MINUTES_LOW=60
APPROVAL_TIMEOUT_MINUTES_MEDIUM=30
APPROVAL_TIMEOUT_MINUTES_HIGH=15
APPROVAL_TIMEOUT_MINUTES_CRITICAL=10
ALLOWLIST_PATH=allowlist.yaml

# ---------------------------------------------------------------------------
# Scheduler / vigia
# ---------------------------------------------------------------------------
VIGIA_POLL_INTERVAL_SECONDS=180
INVENTORY_SYNC_INTERVAL_HOURS=6

# Business-hours window (SPEC section 9)
BUSINESS_HOURS_START_HOUR=8
BUSINESS_HOURS_END_HOUR=18
BUSINESS_HOURS_TIMEZONE=America/Sao_Paulo
BUSINESS_HOURS_WEEKDAYS=0,1,2,3,4
